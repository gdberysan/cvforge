{
  "name": "cv-forge",
  "version": "1.3.0",
  "description": "Evidence-grounded job application system: triage postings, build materials from real evidence, learn from outcomes",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/check-bundle.ts",
    "start": "next start",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "eval:snapshot": "tsx scripts/eval-snapshot.ts",
    "scrub:check": "tsx scripts/scrub-check.ts",
    "release": "tsx scripts/release.ts",
    "demo:build": "tsx scripts/demo-build.ts",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "backup": "mkdir -p backups && sqlite3 \"${CVFORGE_DB_PATH:-data/cvforge.db}\" \".backup backups/cvforge-$(date +%Y%m%d-%H%M%S).db\" && { [ -d evals/private ] && tar -czf \"backups/evals-private-$(date +%Y%m%d-%H%M%S).tgz\" evals/private || true; }"
  },
  "author": "Korven",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "private": true
}
