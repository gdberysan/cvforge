{
  "name": "cv-forge",
  "version": "1.4.0",
  "description": "Evidence-grounded job application system: triage postings, build materials from real evidence, learn from outcomes",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build && tsx scripts/check-bundle.ts",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "eval:snapshot": "tsx scripts/eval-snapshot.ts",
    "eval:cv": "tsx scripts/eval-cv.ts",
    "e2e": "vitest run --config vitest.e2e.config.ts",
    "recheck": "tsx scripts/recheck-cvs.ts",
    "scrub:check": "tsx scripts/scrub-check.ts",
    "release": "tsx scripts/release.ts",
    "demo:build": "tsx scripts/demo-build.ts",
    "format": "biome format --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "backup": "mkdir -p backups && sqlite3 \"${CVFORGE_DB_PATH:-data/cvforge.db}\" \".backup backups/cvforge-$(date +%Y%m%d-%H%M%S).db\" && { [ -d evals/private ] && tar -czf \"backups/evals-private-$(date +%Y%m%d-%H%M%S).tgz\" evals/private || true; }",
    "design:baseline": "tsx scripts/design-baseline.ts",
    "ui:sweep": "tsx scripts/ui-sweep.ts",
    "db:bundle": "tsx scripts/bundle-migrations.ts",
    "test:wasm": "vitest run -c vitest.wasm.config.ts",
    "web:worker": "tsx scripts/gen-web-bridge.ts && tsx scripts/build-web-worker.ts",
    "web:build": "tsx scripts/gen-web-bridge.ts && tsx scripts/build-web-worker.ts --minify && next build web && tsx scripts/web-csp.ts && tsx scripts/web-manifest.ts && tsx scripts/web-site.ts",
    "web:verify": "tsx scripts/web-verify.ts",
    "web:dev": "tsx scripts/gen-web-bridge.ts && tsx scripts/build-web-worker.ts && next dev web -H 127.0.0.1 -p 3100",
    "web:bridge": "tsx scripts/gen-web-bridge.ts",
    "web:extension": "tsx scripts/build-extension.ts"
  },
  "author": "Korven",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@noble/hashes": "^2.4.0",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "better-sqlite3": "^13.0.3",
    "docx": "^9.16.0",
    "drizzle-orm": "^0.45.2",
    "next": "^16.4.6",
    "pdfjs-dist": "^6.3.289",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true
}
