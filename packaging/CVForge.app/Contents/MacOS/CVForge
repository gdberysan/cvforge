#!/bin/bash
# CVForge launcher (macOS). Double-click starts the bundled server with no
# terminal window and opens the browser; if CVForge is already running it
# just reopens the browser. Quitting lives in the app: the nav's "apagar".
set -u

# MacOS/ -> Contents/ -> CVForge.app -> the package root, where LEEME lives.
ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
# A ladder, not one port: another program on 3000 used to leave a buyer with
# no remedy short of a terminal. PORT pins a single rung.
PORTS="${PORT:-3000 3001 3002 3003 3004 3005 3006 3007 3008 3009}"

case "$(uname -m)" in
  arm64) NODE="$ROOT/programa/node/mac-arm64/node" ;;
  *) NODE="$ROOT/programa/node/mac-x64/node" ;;
esac

# The icon route carries the app's name — a cheap identity check so we never
# open the browser onto some other server on the port.
is_cvforge() { curl -sf --max-time 2 "http://localhost:$1/icon.svg" 2>/dev/null | grep -q CVForge; }
# Connection refused (curl exit 7) is the only proof a port is free; a
# timeout or a non-HTTP answer means something else holds it.
is_free() {
  curl -s -o /dev/null --max-time 1 "http://127.0.0.1:$1/" 2>/dev/null
  [ $? -eq 7 ]
}

# Already running on any rung? Reopen it rather than start a second copy
# over the same database.
for p in $PORTS; do
  if is_cvforge "$p"; then
    open "http://localhost:$p"
    exit 0
  fi
done

PORT=""
for p in $PORTS; do
  if is_free "$p"; then PORT="$p"; break; fi
done
if [ -z "$PORT" ]; then
  osascript -e 'display alert "CVForge" message "No hay un puerto libre entre 3000 y 3009. Cierra otro programa local y vuelve a intentarlo.\n\nNo free port between 3000 and 3009. Quit another local program and try again."' >/dev/null 2>&1
  exit 1
fi
URL="http://localhost:$PORT"

mkdir -p "$ROOT/datos"
cd "$ROOT/programa/servidor" || exit 1
HOSTNAME=127.0.0.1 PORT="$PORT" CVFORGE_DB_PATH="$ROOT/datos/cvforge.db" \
  nohup "$NODE" server.js > "$ROOT/datos/cvforge.log" 2>&1 &
disown

for _ in $(seq 1 60); do
  if is_cvforge "$PORT"; then
    open "$URL"
    exit 0
  fi
  sleep 0.5
done

# The server never came up: surface the log instead of failing silently.
open "$ROOT/datos/cvforge.log"
exit 1
