{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/lib/settings": ["./lib/settings.ts"],
      "@/*": ["../*"],
      "#discover": ["../lib/discover/stub.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out", "spike", "extension"]
}
